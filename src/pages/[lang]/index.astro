---
import Base from "../../layouts/Base.astro";
import Subscribe from "../../islands/Subscribe";
import { channels, icon, issuePath, localeFromParam, path, shortDate, strings, newsletterTitle, SITE_URL, readingMinutes, splitStop } from "../../lib/site";
import { getSeoStrings } from "../../../lib/i18n/seoStrings";
import { fmt } from "../../../lib/i18n/siteStrings";
import { latestPerChannel, CACHE_HEADER } from "../../lib/data";
import { legacyRedirect } from "../[...rest]";

export const prerender = false;

const locale = localeFromParam(Astro.params.lang);
// "/settings", "/pricing"… (old links) land here because [lang] matches one segment.
if (!locale) return legacyRedirect(Astro.request, Astro.params.lang ?? "") ?? Astro.rewrite("/404");

const { t, s } = strings(locale);
const list = channels(locale);
const latest = await latestPerChannel(locale);
Astro.response.headers.set("Cache-Control", CACHE_HEADER);

const byNewest = Object.values(latest).sort((a, b) => (b!.date > a!.date ? 1 : b!.date < a!.date ? -1 : b!.createdAt - a!.createdAt));
const newest = byNewest[0];
const newestHref = newest ? issuePath(locale, newest.category, newest.date) : null;
const newestEmail = newestHref ? `${newestHref}/email` : null;
const seo = getSeoStrings(locale);

// Hero: two most recent issues on brand illustrations.
const ART = ["/brand/img-1.jpg", "/brand/img-2.jpg"];
const cards = [0, 1].map((i) => {
  const nl = byNewest[i];
  const ch = nl ? list.find((c) => c.slug === nl.category) : list[[5, 2][i]];
  return {
    img: ART[i],
    channel: ch?.short ?? "",
    title: nl ? newsletterTitle(nl) : ch?.name ?? "",
    summary: nl?.summary ?? ch?.blurb ?? "",
    minutes: nl ? readingMinutes(nl) : null,
    href: nl ? issuePath(locale, nl.category, nl.date) : ch?.href,
  };
});

const [h1a, h1aStop] = splitStop(s.home.heroTitle);
const [h1b, h1bStop] = splitStop(s.home.heroAccent);
const [chTitle, chStop] = splitStop(s.home.channelsTitle);
const [isTitle, isStop] = splitStop(s.home.issueTitle);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TheNode.tech",
  url: `${SITE_URL}${path(locale)}`,
  inLanguage: locale,
  publisher: { "@type": "Organization", name: "TheNode.tech", url: SITE_URL, logo: `${SITE_URL}/brand/logo-on-light.png` },
};
---

<Base locale={locale} title={seo.homeTitle} description={s.home.heroLead} jsonLd={jsonLd}>
  <main>
    <section class="wrap hero">
      <div class="hero-copy">
        <div class="kicker">{s.home.badge}</div>
        <h1>{h1a}<span class="dot">{h1aStop}</span><br />{h1b}<span class="dot">{h1bStop}</span></h1>
        <p class="lead">{s.home.heroLead}</p>
        <Subscribe
          client:load
          locale={locale}
          label={s.home.subscribe}
          placeholder={s.home.emailPlaceholder}
          sending={s.home.sending}
          successNote={s.home.subscribedNote}
          errorText={t.common.somethingWentWrong}
          showArrow
        />
        <p class="note">{s.home.freeNote} <a href={path(locale, "pricing")}>{s.home.learnMore}</a></p>
      </div>

      <div class="stack" aria-hidden="true">
        <div class="sun"></div>
        {cards.map((c, i) => (
          <a class={`card card-${i}`} href={c.href} tabindex="-1">
            <img src={c.img} alt="" width="320" height="240" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
            <div class="card-body">
              <div class="card-meta"><span>{c.channel}</span>{i === 0 && c.minutes && <span class="muted">{fmt(s.category.minRead, { n: c.minutes })}</span>}</div>
              <div class="card-title">{c.title}</div>
              {i === 0 && c.summary && <div class="card-sum">{c.summary}</div>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="channels" class="band-light">
      <div class="wrap section">
        <div class="section-head">
          <h2>{chTitle}<span class="dot">{chStop}</span></h2>
          <p class="muted">{s.home.channelsLead}</p>
        </div>
        <div class="ledger">
          {list.map((ch) => {
            const nl = latest[ch.slug];
            return (
              <a href={ch.href} class="row">
                <span class="num">{ch.num}</span>
                <span class="disc" style={`background:${ch.hue};width:52px;height:52px`}><img src={ch.icon} alt="" width="24" height="24" /></span>
                <span class="row-text">
                  <span class="row-name">{ch.name}</span>
                  <span class="row-blurb">{ch.blurb}</span>
                </span>
                <span class="row-status">{nl ? fmt(s.home.latestOn, { date: shortDate(nl.date, locale) }) : s.home.comingSoon}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="band-dark">
      <div class="wrap section issue-grid">
        <div class="issue-copy">
          <div class="kicker">{s.home.issueKicker}</div>
          <h2>{isTitle}<span class="dot">{isStop}</span></h2>
          <p>{s.home.issueLead}</p>
          <div class="chips">
            <span>{s.home.featureBrief}</span>
            <span>{s.home.featureNumbers}</span>
            <span>{s.home.featureLinks}</span>
          </div>
          {newestHref && (
            <a href={newestHref} class="btn on-dark read-latest">{s.home.readLatest}<img src={icon("arrow-up-right")} alt="" width="18" height="18" /></a>
          )}
        </div>
        <div class="issue-frame">
          <iframe src={newestEmail ?? "/brand/sample-issue.html"} title={s.home.readLatest} scrolling="no" loading="lazy" tabindex="-1"></iframe>
        </div>
      </div>
    </section>

    <section class="band-light stats-band">
      <div class="wrap">
        <div class="stats">
          {[
            [s.home.stat1Value, s.home.stat1Title, s.home.stat1Body],
            [s.home.stat2Value, s.home.stat2Title, s.home.stat2Body],
            [s.home.stat3Value, s.home.stat3Title, s.home.stat3Body],
          ].map(([v, title, body]) => (
            <div class="stat">
              <div class="stat-value">{v}</div>
              <div class="stat-title">{title}</div>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { padding-top: 96px; padding-bottom: 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 30px; }
  h1 { margin: 0; font-weight: 700; font-size: clamp(48px, 7vw, 92px); line-height: .95; letter-spacing: -0.04em; text-wrap: balance; }
  .lead { margin: 0; font-size: 19px; line-height: 1.55; color: var(--ink-2); max-width: 500px; text-wrap: pretty; }

  .stack { position: relative; height: 560px; width: 100%; max-width: 460px; justify-self: end; }
  .sun { position: absolute; top: 120px; left: -40px; width: 380px; height: 380px; border-radius: 50%; background: var(--orange); }
  .card { position: absolute; display: block; background: var(--paper-2); border: var(--rule); overflow: hidden; text-decoration: none; color: var(--ink); }
  .card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-bottom: var(--rule); }
  .card-1 { top: 30px; left: 10px; width: 290px; transform: rotate(-5deg); box-shadow: 8px 8px 0 var(--ink); }
  .card-0 { top: 190px; right: 0; width: 320px; transform: rotate(3deg); box-shadow: 10px 10px 0 var(--ink); z-index: 2; }
  .card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; }
  .card-1 .card-body { padding: 14px 16px 16px; gap: 6px; }
  .card-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: var(--orange); }
  .card-title { font-weight: 600; font-size: 16px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-0 .card-title { font-size: 18px; }
  .card-sum { font-size: 14px; line-height: 1.5; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 760px) {
    .hero { padding-top: 56px; padding-bottom: 64px; gap: 40px; }
    .stack { height: 500px; justify-self: center; max-width: 360px; }
    .sun { width: 300px; height: 300px; left: -20px; top: 110px; }
    .card-0 { width: 280px; top: 170px; }
    .card-1 { width: 240px; left: 0; }
  }

  .band-light { border-top: var(--rule); background: var(--paper-2); }
  .section { padding-top: 72px; padding-bottom: 96px; }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 40px; }
  .section-head h2, .issue-copy h2 { margin: 0; font-weight: 700; font-size: 44px; letter-spacing: -0.035em; line-height: 1; }
  .section-head p { margin: 0; font-size: 16px; }

  .ledger { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(500px, 100%), 1fr)); border-top: var(--rule); border-left: var(--rule); }
  .row { display: grid; grid-template-columns: 56px 52px 1fr auto; gap: 18px; align-items: center; padding: 22px 24px; border-right: var(--rule); border-bottom: var(--rule); text-decoration: none; color: var(--ink); background: var(--paper-2); transition: background .12s, color .12s; }
  .row:hover { background: var(--orange); color: var(--white); }
  .num { font-weight: 700; font-size: 34px; letter-spacing: -0.04em; line-height: 1; opacity: .35; }
  .row-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .row-name { font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  .row-blurb { font-size: 14px; line-height: 1.45; opacity: .75; }
  .row-status { font-size: 12px; font-weight: 600; letter-spacing: .6px; text-transform: uppercase; white-space: nowrap; opacity: .7; }
  @media (max-width: 600px) {
    .row { grid-template-columns: 44px 1fr; grid-template-areas: "disc text" "disc status"; gap: 6px 14px; padding: 18px 16px; }
    .num { display: none; }
    .row .disc { grid-area: disc; width: 44px !important; height: 44px !important; align-self: start; }
    .row-text { grid-area: text; }
    .row-status { grid-area: status; }
    .row-name { font-size: 18px; }
  }

  .band-dark { background: var(--ink); color: var(--white); border-top: var(--rule); }
  .issue-grid { padding-top: 88px; padding-bottom: 88px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 56px; align-items: center; }
  .issue-copy { display: flex; flex-direction: column; gap: 22px; }
  .issue-copy h2 { line-height: 1.02; text-wrap: balance; }
  .issue-copy p { margin: 0; font-size: 17px; line-height: 1.55; color: var(--on-dark); max-width: 480px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .chips span { font-size: 13px; font-weight: 600; padding: 8px 12px; border: 2px solid var(--white); }
  .read-latest { align-self: flex-start; margin-top: 12px; height: 52px; font-size: 15px; }
  .issue-frame { justify-self: end; width: 100%; max-width: 460px; height: 560px; overflow: hidden; border: 2px solid var(--white); background: var(--white); box-shadow: 12px 12px 0 var(--orange); }
  .issue-frame iframe { width: 600px; height: 1100px; border: 0; transform: scale(.766); transform-origin: 0 0; pointer-events: none; display: block; }
  @media (max-width: 700px) { .issue-frame { justify-self: center; max-width: 340px; height: 440px; } .issue-frame iframe { transform: scale(.566); } }

  .stats-band .wrap { padding-top: 88px; padding-bottom: 104px; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); border-left: var(--rule); }
  .stat { display: flex; flex-direction: column; gap: 14px; padding: 8px 32px 8px 28px; border-right: var(--rule); }
  .stat-value { font-weight: 700; font-size: 64px; line-height: 1; letter-spacing: -0.04em; color: var(--orange); }
  .stat-title { font-weight: 600; font-size: 20px; }
  .stat p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
  @media (max-width: 860px) {
    .stats { border-left: 0; border-top: var(--rule); }
    .stat { border-right: 0; border-bottom: var(--rule); padding: 24px 0; }
  }
</style>
