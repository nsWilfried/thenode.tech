---
import Base from "../../layouts/Base.astro";
import PremiumCta from "../../islands/PremiumCta";
import { icon, path, staticLocalePaths, strings, type Locale } from "../../lib/site";

export const getStaticPaths = staticLocalePaths;
const locale = Astro.params.lang as Locale;
const { t, s } = strings(locale);
const p = t.pricing;
const premiumIcons = ["check", "languages", "zap", "calendar-days", "rocket", "check", "check"];
const faq = [
  [p.faqLanguagesQ, p.faqLanguagesA],
  [p.faqScheduleQ, p.faqScheduleA],
  [p.faqSourcesQ, p.faqSourcesA],
  [p.faqCancelQ, p.faqCancelA],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base locale={locale} title={`${p.title} — TheNode`} description={p.subtitle} route="pricing" jsonLd={jsonLd}>
  <main>
    <section class="wrap page">
      <div class="head">
        <h1>{p.title}</h1>
        <p>{p.subtitle}</p>
      </div>
      <div class="plans">
        <div class="plan">
          <div class="plan-name">{p.free}</div>
          <div class="price"><span class="amount">{p.freePriceLabel}</span><span class="per">{p.perMonth}</span></div>
          <div class="desc">{p.freeDescription}</div>
          <ul>{p.freeFeatures.map((f) => <li><img src={icon("check")} alt="" width="18" height="18" />{f}</li>)}</ul>
          <a href={path(locale)} class="btn ghost sm full">{p.getStartedFree}</a>
        </div>
        <div class="plan dark">
          <div class="ribbon">{p.recommended}</div>
          <div class="plan-name">{p.premium}</div>
          <div class="price"><span class="amount">{p.premiumPriceLabel}</span><span class="per">{p.perMonth}</span></div>
          <div class="desc">{p.premiumDescription}</div>
          <ul>{p.premiumFeatures.map((f, i) => <li><img src={icon(premiumIcons[i] ?? "check")} alt="" width="18" height="18" class="icon-dark" />{f}</li>)}</ul>
          <div class="cta">
            <PremiumCta client:load locale={locale} subscribe={p.subscribeWithPolar} signInToSubscribe={p.signInToSubscribe} alreadyPremium={t.settings.manageSubscription} />
          </div>
        </div>
      </div>
      <div class="faq">
        <h2>{p.faqTitle}</h2>
        {faq.map(([q, a]) => (
          <div class="qa"><h3>{q}</h3><p>{a}</p></div>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .page { padding-top: 80px; padding-bottom: 88px; }
  .head { max-width: 620px; display: flex; flex-direction: column; gap: 16px; }
  h1 { margin: 0; font-weight: 700; font-size: clamp(40px, 5vw, 64px); letter-spacing: -0.035em; line-height: 1; }
  .head p { margin: 0; font-size: 19px; color: var(--ink-2); }
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 24px; margin-top: 48px; }
  .plan { position: relative; display: flex; flex-direction: column; gap: 22px; padding: 36px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper-2); }
  .plan.dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .ribbon { position: absolute; top: -12px; left: 36px; font-size: 12px; letter-spacing: .8px; text-transform: uppercase; font-weight: 600; background: var(--orange); color: var(--paper); padding: 6px 10px; border-radius: 6px; }
  .plan-name { font-weight: 600; font-size: 22px; }
  .price { display: flex; align-items: baseline; gap: 8px; }
  .amount { font-weight: 700; font-size: 56px; line-height: 1; letter-spacing: -0.03em; }
  .per, .desc { font-size: 15px; color: var(--muted); }
  .dark .per, .dark .desc { color: var(--on-dark); }
  .desc { color: var(--ink-2); }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.4; }
  li { display: flex; gap: 12px; align-items: center; }
  li img { flex: none; }
  .full { margin-top: auto; width: 100%; }
  .cta { margin-top: auto; }
  .cta :global(.btn) { width: 100%; }
  .faq { max-width: 720px; margin-top: 88px; }
  .faq h2 { margin: 0 0 8px; font-weight: 700; font-size: 32px; letter-spacing: -0.03em; }
  .qa { padding: 22px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
  .qa h3 { margin: 0; font-weight: 600; font-size: 18px; }
  .qa p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
</style>
