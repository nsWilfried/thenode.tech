---
import Base from "../../layouts/Base.astro";
import PremiumCta from "../../islands/PremiumCta";
import { path, splitStop, staticLocalePaths, strings, type Locale } from "../../lib/site";

export const getStaticPaths = staticLocalePaths;
const locale = Astro.params.lang as Locale;
const { t, s } = strings(locale);
const p = t.pricing;
const [title, stop] = splitStop(p.title);
const faq = [
  [p.faqLanguagesQ, p.faqLanguagesA],
  [p.faqScheduleQ, p.faqScheduleA],
  [p.faqSourcesQ, p.faqSourcesA],
  [p.faqCancelQ, p.faqCancelA],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base locale={locale} title={`${p.title} — TheNode`} description={p.subtitle} route="pricing" jsonLd={jsonLd}>
  <main>
    <section class="wrap page">
      <div class="head">
        <h1>{title}<span class="dot">{stop || "."}</span></h1>
        <p>{p.subtitle}</p>
      </div>
      <div class="plans">
        <div class="plan">
          <div class="plan-name">{p.free}</div>
          <div class="price"><span class="amount">{p.freePriceLabel}</span><span class="per">{p.perMonth}</span></div>
          <div class="desc">{p.freeDescription}</div>
          <ul>{p.freeFeatures.map((f) => <li><span class="bullet"></span>{f}</li>)}</ul>
          <a href={path(locale)} class="btn ghost sm full">{p.getStartedFree}</a>
        </div>
        <div class="plan dark">
          <div class="ribbon">{p.recommended}</div>
          <div class="plan-name">{p.premium}</div>
          <div class="price"><span class="amount">{p.premiumPriceLabel}</span><span class="per">{p.perMonth}</span></div>
          <div class="desc">{p.premiumDescription}</div>
          <ul>{p.premiumFeatures.map((f) => <li><span class="bullet"></span>{f}</li>)}</ul>
          <div class="cta">
            <PremiumCta client:load locale={locale} subscribe={p.subscribeWithPolar} signInToSubscribe={p.signInToSubscribe} alreadyPremium={t.settings.manageSubscription} />
          </div>
        </div>
      </div>
      <div class="faq">
        <h2>{p.faqTitle}</h2>
        {faq.map(([q, a]) => (
          <div class="qa"><h3>{q}</h3><p>{a}</p></div>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .page { padding-top: 80px; padding-bottom: 96px; }
  .head { max-width: 620px; display: flex; flex-direction: column; gap: 16px; }
  h1 { margin: 0; font-weight: 700; font-size: clamp(40px, 5vw, 64px); letter-spacing: -0.035em; line-height: 1; }
  .head p { margin: 0; font-size: 19px; color: var(--ink-2); }
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 32px; margin-top: 56px; }
  .plan { position: relative; display: flex; flex-direction: column; gap: 22px; padding: 36px; border: var(--rule); background: var(--paper-2); box-shadow: 10px 10px 0 var(--ink); }
  .plan.dark { background: var(--ink); color: var(--white); box-shadow: 10px 10px 0 var(--orange); }
  .ribbon { position: absolute; top: -14px; left: 34px; font-size: 12px; letter-spacing: .8px; text-transform: uppercase; font-weight: 600; background: var(--orange); color: var(--white); padding: 6px 10px; border: var(--rule); }
  .plan-name { font-weight: 600; font-size: 22px; }
  .price { display: flex; align-items: baseline; gap: 8px; }
  .amount { font-weight: 700; font-size: 64px; line-height: 1; letter-spacing: -0.04em; }
  .per { font-size: 15px; color: var(--muted); }
  .desc { font-size: 15px; color: var(--ink-2); padding-bottom: 22px; border-bottom: var(--rule); }
  .dark .per, .dark .desc { color: var(--on-dark); }
  .dark .desc { border-bottom-color: var(--white); }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.4; }
  li { display: flex; gap: 12px; align-items: center; }
  .bullet { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); flex: none; }
  .full { margin-top: auto; width: 100%; }
  .cta { margin-top: auto; }
  .cta :global(.btn) { width: 100%; border-color: var(--white); box-shadow: none; }
  .cta :global(.btn:hover) { background: var(--white); color: var(--ink); }
  .faq { max-width: 720px; margin-top: 96px; }
  .faq h2 { margin: 0; font-weight: 700; font-size: 32px; letter-spacing: -0.03em; padding-bottom: 16px; border-bottom: var(--rule); }
  .qa { padding: 22px 0; border-bottom: var(--rule); display: flex; flex-direction: column; gap: 8px; }
  .qa h3 { margin: 0; font-weight: 600; font-size: 18px; }
  .qa p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
</style>
